# Nexus Director — Environment Variables
# Copy this file to .env.local and fill in your keys before running the dev server.

# ── AI Model Keys ───────────────────────────────────────────────────────────────

# Google Gemini (optional; used by non-Academy routes)
GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (Academy uses DeepSeek Chat v3 end to end)
DEEPSEEK_API_KEY=

# Anthropic Claude (optional; used by non-Academy routes)
ANTHROPIC_API_KEY=

# Deepgram (used by /api/transcribe — speech-to-text before ingest)
DEEPGRAM_API_KEY=

# ── Model Overrides (optional) ──────────────────────────────────────────────────
# Defaults are set in lib/env.ts — override only when needed.

# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# Academy routes are pinned to deepseek-chat and do not use this override.
# CLAUDE_MODEL=claude-haiku-4-5

# ── Nexus Code runner (optional sidecar) ───────────────────────────────────────
# The web process never executes generated code directly. Set these only when an
# isolated runner service is deployed next to Nexus.
# CODING_RUNNER_URL=http://127.0.0.1:8090
# CODING_RUNNER_TOKEN=
