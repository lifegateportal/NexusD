# Nexus Director — Environment Variables
# Copy this file to .env.local and fill in your keys before running the dev server.

# ── AI Model Keys ───────────────────────────────────────────────────────────────

# Google Gemini (optional; used by non-Academy routes)
GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (Academy uses DeepSeek Chat v3 end to end)
DEEPSEEK_API_KEY=

# Anthropic Claude (optional; used by non-Academy routes)
ANTHROPIC_API_KEY=

# Deepgram (used by /api/transcribe — speech-to-text before ingest)
DEEPGRAM_API_KEY=

# YouTube Data API v3 (used to fetch public videos from the Lifegate Broadcast channel)
YOUTUBE_API_KEY=

# Cloudflare R2 storage (required to keep generated Shorts and drafts on the server)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Required for publishing uploaded Shorts assets.
R2_PUBLIC_URL=

# ── YouTube Shorts capture worker (existing Linux host) ─────────────────────────
# Shared persistent directory used by the Nexus app and the PM2 capture worker.
# SHORT_CAPTURE_JOB_DIR=/var/lib/nexus-short-capture
# Create this as a private R2 bucket; it is separate from public Shorts assets.
# SHORT_CAPTURE_R2_BUCKET=
# Internal URL the worker uses to load the capture-only Shorts preview.
# SHORT_CAPTURE_APP_ORIGIN=http://127.0.0.1:3000
# Optional trusted public HTTPS origin for YouTube playback in the worker's browser.
# SHORT_CAPTURE_BROWSER_ORIGIN=https://nexusdirector.example
# Optional system executable overrides.
# SHORT_CAPTURE_CHROMIUM_PATH=/usr/bin/chromium
# SHORT_CAPTURE_FFMPEG_PATH=ffmpeg
# SHORT_CAPTURE_XVFB_PATH=Xvfb
# SHORT_CAPTURE_PULSE_SINK=nexus_capture
# SHORT_CAPTURE_DISPLAY=:99

# Stock media for Shorts Studio (server-side only)
PEXELS_API_KEY=
JAMENDO_CLIENT_ID=
# Set true only after Jamendo confirms commercial/API licensing for this application.
JAMENDO_COMMERCIAL_USE_APPROVED=false

# ── Model Overrides (optional) ──────────────────────────────────────────────────
# Defaults are set in lib/env.ts — override only when needed.

# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# Academy routes are pinned to deepseek-chat and do not use this override.
# CLAUDE_MODEL=claude-haiku-4-5

# ── Nexus Code runner (optional sidecar) ───────────────────────────────────────
# The web process never executes generated code directly. Set these only when an
# isolated runner service is deployed next to Nexus.
# CODING_RUNNER_URL=http://127.0.0.1:8090
# CODING_RUNNER_TOKEN=
# CODING_RUNNER_PREVIEW_RETENTION_MS=1800000
# CODING_RUNNER_MAX_PREVIEWS=4

# ── Nexus Code GitHub publishing (optional) ───────────────────────────────────
# Create a GitHub OAuth App and set its callback URL to the same URL below.
# The repo scope can access all public and private repositories on the account.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=https://your-domain.example/api/coding/github/callback
# Generate a unique random secret of at least 32 characters; keep it private.
# GITHUB_OAUTH_SESSION_SECRET=
